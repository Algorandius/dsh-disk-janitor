{
  "name": "dsh-disk-janitor",
  "version": "0.1.1",
  "description": "Disk Janitor for DeepSeek Harness: inspect DSH disk usage and reclaim only caches that are safe to rebuild, keeping the resources currently in use.",
  "license": "MIT",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon-180.png"
  },
  "files": [
    "index.js",
    "client.js",
    "lib/*.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/*.png",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "disk",
    "cleanup",
    "cache",
    "janitor"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}